# Skopiuj ten plik jako .env i uzupełnij wartości.
# Plik .env nie trafia do repozytorium.

# Aplikacja
APP_ENV=dev
SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag
FRONTEND_URL=http://localhost:5173

# Baza danych (PostgreSQL + pgvector w Dockerze)
POSTGRES_USER=quizforge
POSTGRES_PASSWORD=quizforge
POSTGRES_DB=quizforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quizforge:quizforge@localhost:5432/quizforge

# Redis (sesje, stan gier, kolejka zadań)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Poczta lokalna (Mailpit, podgląd na http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Apocrypha <no-reply@apocrypha.local>

# Klucz główny do szyfrowania kluczy API i sekretów 2FA (AES-256-GCM, 32 bajty w base64).
# Wygeneruj: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Po zmianie klucza: zwiększ MASTER_KEY_VERSION, a stary wpisz do MASTER_KEYS_OLD jako "1:stary_klucz".
MASTER_KEY=
MASTER_KEY_VERSION=1
MASTER_KEYS_OLD=

# Klucze systemowe AI na czas testów (etap 4)
ALLOW_SYSTEM_KEYS=true
SYSTEM_DAILY_CALLS=50
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Modele lokalne (LM Studio, serwer zgodny z API OpenAI)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
